# ==============================================================================
# SharePlate - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT .env TO VERSION CONTROL
# ==============================================================================

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=120

# Database Configuration (MySQL 8+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shareplate_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
# Optional full URI override:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/shareplate_db

# Test Database
TEST_DB_NAME=shareplate_test_db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Binding
PORT=5000
HOST=127.0.0.1

# AI Vision & Language Provider (Optional, safe heuristic fallback if omitted)
# Supported providers: 'openai', 'gemini', 'fallback'
AI_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Storage Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760 # 10MB limit

# Food Safety Configuration (FSSAI guidelines)
FSSAI_COOKED_MAX_HOURS_AMBIENT=4
FSSAI_HOT_HOLD_MIN_TEMP_C=60
FSSAI_COLD_HOLD_MAX_TEMP_C=5
